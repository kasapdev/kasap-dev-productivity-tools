# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# env files - never commit real secrets
.env
.env.*
!.env.example

# local runtime data (sqlite db, logs, dotfiles fixtures) - matched by
# extension, not a blanket "data/" directory rule, which would also hide any
# real checked-in data/ folder a package adds later.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.log

# editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# test/coverage
coverage/
