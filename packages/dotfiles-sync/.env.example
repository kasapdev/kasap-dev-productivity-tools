# Passphrase used to derive the AES-256-GCM key for encrypting/decrypting
# manifest entries marked "secret": true.
#
# dotfiles-sync reads this env var first; if it is unset, it falls back to
# an interactive (NOT masked) prompt on stdin. For real use and for CI,
# always set this env var instead of relying on the prompt.
#
# Replace the value below with your own passphrase. Do NOT commit a real
# passphrase to source control -- this file is a template only.
DOTFILES_SYNC_PASSPHRASE=replace-with-a-long-random-passphrase-of-your-choosing
